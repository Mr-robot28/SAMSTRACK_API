{
  "info": {
    "_postman_id": "samstrack-api-collection-001",
    "name": "SamsTrack API",
    "description": "Full Postman collection for the SamsTrack Student Attendance Management System REST API. Covers User (login, register, CRUD, role filters), Student (CRUD), Subject (CRUD), and Attendance (take, list all, filter by date + subject).\n\nDefault baseUrl is http://localhost:8091. Change the `baseUrl` collection variable to point at any deployed instance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/login-user",
              "host": ["{{baseUrl}}"],
              "path": ["user", "login-user"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faculty01\",\n  \"password\": \"pass1234\"\n}"
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/register-user",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register-user"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faculty01\",\n  \"password\": \"pass1234\",\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"asha@example.com\",\n  \"role\": \"faculty\"\n}"
            }
          }
        },
        {
          "name": "Get User By Username",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get-user-by-username/faculty01",
              "host": ["{{baseUrl}}"],
              "path": ["user", "get-user-by-username", "faculty01"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get-all-user",
              "host": ["{{baseUrl}}"],
              "path": ["user", "get-all-user"]
            }
          }
        },
        {
          "name": "Get All Admins",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get-all-admin",
              "host": ["{{baseUrl}}"],
              "path": ["user", "get-all-admin"]
            }
          }
        },
        {
          "name": "Get All Faculties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get-all-faculty",
              "host": ["{{baseUrl}}"],
              "path": ["user", "get-all-faculty"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/update-user",
              "host": ["{{baseUrl}}"],
              "path": ["user", "update-user"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"faculty01\",\n  \"password\": \"newpass5678\",\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"asha@example.com\",\n  \"role\": \"faculty\"\n}"
            }
          }
        },
        {
          "name": "Delete User By Username",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/delete-user-by-username?username=faculty01",
              "host": ["{{baseUrl}}"],
              "path": ["user", "delete-user-by-username"],
              "query": [
                {
                  "key": "username",
                  "value": "faculty01"
                }
              ]
            }
          }
        }
      ]
    },
